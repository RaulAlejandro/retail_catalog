<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Catálogo Retail" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />
    <%= stylesheet_link_tag "metronic/plugins.bundle", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "metronic/style.bundle", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body id="kt_body" class="header-fixed header-tablet-and-mobile-fixed">
    <%= render "shared/header" %>

    <div class="d-flex flex-column flex-root">
      <div class="page d-flex flex-row flex-column-fluid">
        <%= yield %>
      </div>
    </div>

    <%= render "shared/footer" %>

    <%= javascript_include_tag "metronic/plugins.bundle", "data-turbo-track": "reload", defer: true %>
    <%= javascript_include_tag "metronic/scripts.bundle", "data-turbo-track": "reload", defer: true %>
  </body>
</html>
