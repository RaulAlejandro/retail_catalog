<div class="col-md-6 col-xl-4">
  <div class="card card-flush h-100">
    <%= link_to product_path(product), data: { turbo_frame: "_top", turbo_prefetch: false }, class: "card-img-top position-relative d-block" do %>
      <%= image_tag product.image_url || "placeholder.png",
          class: "w-100",
          style: "height: 250px; object-fit: cover;",
          alt: product.name %>

      <% if product.has_discount? %>
        <span class="badge badge-danger position-absolute top-0 end-0 m-3">
          -<%= product.discount_percentage %>%
        </span>
      <% end %>
    <% end %>

    <div class="card-body d-flex flex-column">
      <div class="mb-2">
        <span class="badge badge-light-primary fs-7 fw-bold">
          <%= product.category %>
        </span>
      </div>

      <h4 class="fw-bold text-gray-800 mb-3">
        <%= link_to product.name, product_path(product),
            data: { turbo_frame: "_top", turbo_prefetch: false },
            class: "text-gray-800 text-hover-primary text-decoration-none" %>
      </h4>

      <div class="text-muted fs-7 mb-3">
        <%= product.brand %>
      </div>

      <p class="text-gray-600 fs-7 mb-4 flex-grow-1">
        <%= truncate(product.description, length: 100) %>
      </p>

      <div class="d-flex justify-content-between align-items-center mt-auto">
        <div>
          <% if product.has_discount? %>
            <div class="text-muted text-decoration-line-through fs-7">
              <%= product.formatted_old_price %>
            </div>
          <% end %>
          <span class="fs-2 fw-bold text-primary">
            <%= product.formatted_price %>
          </span>
        </div>

        <% if product.in_stock? %>
          <%= link_to "Ver detalles", product_path(product),
              data: { turbo_frame: "_top", turbo_prefetch: false },
              class: "btn btn-primary btn-sm" %>
        <% else %>
          <span class="badge badge-light-danger">Agotado</span>
        <% end %>
      </div>
    </div>
  </div>
</div>
