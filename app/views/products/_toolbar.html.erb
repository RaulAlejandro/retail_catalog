<div class="card card-flush mb-7">
  <div class="card-body d-flex align-items-center justify-content-between">
    <div class="flex-grow-1 me-5">
      <%= form_with url: products_path, method: :get,
          data: {
            controller: "search",
            turbo_frame: "products_grid",
            turbo_action: "advance"
          },
          class: "w-100" do |f| %>

        <div class="position-relative">
          <%= f.text_field :query,
              value: params[:query],
              placeholder: "Buscar productos...",
              class: "form-control form-control-solid ps-12",
              data: {
                search_target: "input",
                action: "input->search#search"
              } %>

          <span class="position-absolute top-50 start-0 translate-middle-y ms-4">
            <i class="bi bi-search fs-3"></i>
          </span>
        </div>

        <%= f.hidden_field :category, value: params[:category] %>
        <%= f.hidden_field :brand, value: params[:brand] %>
        <%= f.hidden_field :min_price, value: params[:min_price] %>
        <%= f.hidden_field :max_price, value: params[:max_price] %>
        <%= f.hidden_field :price_range, value: params[:price_range] %>
        <%= f.hidden_field :in_stock_only, value: params[:in_stock_only] %>
        <%= f.hidden_field :sort_by, value: params[:sort_by] %>
      <% end %>
    </div>

    <div class="flex-shrink-0">
      <%= form_with url: products_path, method: :get,
          data: { turbo_frame: "products_grid", turbo_action: "advance" } do |f| %>

        <%= f.select :sort_by,
            options_for_select([
              ["Más recientes", "newest"],
              ["Precio: menor a mayor", "price_asc"],
              ["Precio: mayor a menor", "price_desc"]
            ], params[:sort_by]),
            {},
            class: "form-select form-select-solid",
            data: { action: "change->filters#submit" } %>

        <%= f.hidden_field :query, value: params[:query] %>
        <%= f.hidden_field :category, value: params[:category] %>
        <%= f.hidden_field :brand, value: params[:brand] %>
        <%= f.hidden_field :min_price, value: params[:min_price] %>
        <%= f.hidden_field :max_price, value: params[:max_price] %>
        <%= f.hidden_field :price_range, value: params[:price_range] %>
        <%= f.hidden_field :in_stock_only, value: params[:in_stock_only] %>
      <% end %>
    </div>
  </div>
</div>
