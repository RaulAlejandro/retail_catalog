<div id="kt_header" class="header align-items-stretch">
  <div class="container-fluid d-flex align-items-stretch justify-content-between">
    <div class="d-flex align-items-center d-lg-none ms-n2 me-2" title="Show aside menu">
      <div class="btn btn-icon btn-active-light-primary w-30px h-30px w-md-40px h-md-40px" id="kt_aside_mobile_toggle">
        <span class="svg-icon svg-icon-1">
          <i class="bi bi-list fs-1"></i>
        </span>
      </div>
    </div>

    <div class="d-flex align-items-center flex-grow-1 flex-lg-grow-0">
      <%= link_to root_path, class: "d-lg-none", data: { turbo_prefetch: false } do %>
        <h1 class="text-dark fw-bold mb-0">Catálogo Retail</h1>
      <% end %>
      <%= link_to root_path, class: "d-none d-lg-inline-block", data: { turbo_prefetch: false } do %>
        <h1 class="text-dark fw-bold mb-0 me-2">Catálogo Retail</h1>
      <% end %>
    </div>

    <div class="d-flex align-items-stretch justify-content-between flex-lg-grow-1">
      <div class="d-flex align-items-stretch" id="kt_header_nav">
        <div class="header-menu align-items-stretch">
          <div class="menu menu-lg-rounded menu-column menu-lg-row menu-state-bg menu-title-gray-700 menu-state-title-primary menu-state-icon-primary menu-state-bullet-primary menu-arrow-gray-400 fw-bold my-5 my-lg-0 align-items-stretch">
            <div class="menu-item me-lg-1">
              <%= link_to "Inicio", root_path, class: "menu-link py-3 #{'active' if current_page?(root_path)}", data: { turbo_prefetch: false } %>
            </div>
            <div class="menu-item me-lg-1">
              <%= link_to "Productos", products_path, class: "menu-link py-3 #{'active' if current_page?(products_path)}", data: { turbo_prefetch: false } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
